# 环境变量模板
#
# 这个文件由启动器读取、**不入库**（只有这个 .example 示例文件入库）。
# 它只在启动瞬间被 run.sh 翻译成服务端命令行参数，服务端本身不读它。
#
# ── Linux：由 systemd 的 EnvironmentFile= 读取 ──
#   sudo mkdir -p /etc/easy-charles
#   sudo cp easy-charles.env.example /etc/easy-charles/easy-charles.env
#   sudo chmod 600 /etc/easy-charles/easy-charles.env
#
# ── macOS：放在解包目录里，两个 .command 脚本会自动 source 它 ──
#   cd <解包目录>
#   cp easy-charles.env.example easy-charles.env
#   chmod 600 easy-charles.env

# 控制台登录口令。默认值 123456 只适合本机自用，暴露到内网前必须改。
# 口令是全局单一口令（不是每用户密码），用户之间靠手机号空间 + 设备绑定隔离（ADR-015）。
EC_PASSWORD=your-password

# 管理员手机号白名单，逗号分隔。不配置 = 没有管理员（ADR-018）。
EC_ADMIN=13800000000

# 监听端口，默认 8899
EC_PORT=8899

# 数据目录（必须绝对路径）。rules.json / store.json / snapshots/ 都在这里。
EC_DATA_DIR=/var/lib/easycharles

# 指定 node 可执行文件；留空则用 PATH 里的 node
# EC_NODE_BIN=/usr/local/bin/node

# 额外参数（EC_* 覆盖不到的 flag 用这个通道；写成一个参数串，按空格切分）
# 优先级：命令行 > EC_* > EC_ARGS > 默认值，所以这里抢不过上面任何显式设置。
#
# 典型用途：第三方抓包 SDK 的兼容层。头名以你们 App 侧 mock SDK 为准
#（`--compat-user-id-header` / `--compat-user-name-header` 同理，见 easy-charles.conf.example）：
#   EC_ARGS="--compat-route /mock-proxy --compat-target-header x-mock-original-url --compat-device-header mock-display-name --app-id my-app"
#
# 也可以放服务端容量类参数，例如共享给多人时限制内存：
#   EC_ARGS="--record-mode sample --sample 65536 --max-records 5000"
EC_ARGS=""
